{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "onboarding": false,
  "branchPrefix": "renovate/",
  "automerge": true,
  "major": {
    "automerge": false
  },
  "enabledManagers": ["flux", "github-actions", "kubernetes", "mise"],
  "flux": {
    "managerFilePatterns": ["/^(apps|clusters|infrastructure)\\/.*\\.ya?ml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/^(apps|clusters|infrastructure)\\/.*\\.ya?ml$/"]
  },
  "mise": {
    "managerFilePatterns": ["/^docs\\/config\\.toml$/"]
  }
}
