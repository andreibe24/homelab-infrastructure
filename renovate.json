{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "branchPrefix": "renovate/",
  "automerge": true,
  "platformAutomerge": false,
  "major": {
    "automerge": false
  },
  "enabledManagers": [
    "flux",
    "github-actions",
    "kubernetes",
    "mise",
    "custom.regex",
    "pip_requirements",
    "npm",
    "dockerfile"
  ],
  "flux": {
    "managerFilePatterns": ["/^(apps|clusters|infrastructure)\\/.*\\.ya?ml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/^(apps|clusters|infrastructure)\\/.*\\.ya?ml$/"]
  },
  "packageRules": [
    {
      "description": "Update forum images together using plain X.Y.Z release image tags",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "ghcr.io/andreibe24/homelab-infrastructure/webapp-django-vite-backend",
        "ghcr.io/andreibe24/homelab-infrastructure/webapp-django-vite-frontend"
      ],
      "groupName": "forum app images",
      "allowedVersions": "/^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$/"
    },
    {
      "description": "Group forum backend dependencies, its base image and the CI Python version",
      "matchFileNames": [
        "src/webapp-django-vite/backend/**",
        "src/webapp-django-vite/Dockerfile.backend"
      ],
      "groupName": "forum backend dependencies"
    },
    {
      "description": "CI Python must move with the backend base image",
      "matchFileNames": [".github/workflows/lint-src.yaml"],
      "matchDepNames": ["python"],
      "groupName": "forum backend dependencies"
    },
    {
      "description": "Group forum frontend dependencies, its base images and the CI Node.js version",
      "matchFileNames": [
        "src/webapp-django-vite/frontend/**",
        "src/webapp-django-vite/Dockerfile.frontend"
      ],
      "groupName": "forum frontend dependencies"
    },
    {
      "description": "CI Node.js must move with the frontend build image",
      "matchFileNames": [".github/workflows/lint-src.yaml"],
      "matchDepNames": ["node"],
      "groupName": "forum frontend dependencies"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^(apps|clusters|infrastructure)\\/.*\\.sh$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\s+[A-Z0-9_]+_VERSION=\"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^clusters\\/dev\\/bootstrap\\/kind\\.cluster\\.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\s+image:\\s*kindest/node:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ]
    }
  ],
  "mise": {
    "managerFilePatterns": ["/^docs\\/config\\.toml$/"]
  }
}
