{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "branchPrefix": "renovate/",
  "automerge": true,
  "platformAutomerge": false,
  "major": {
    "automerge": false
  },
  "enabledManagers": [
    "flux",
    "github-actions",
    "gitlabci",
    "kubernetes",
    "kustomize",
    "mise",
    "custom.regex",
    "pip_requirements",
    "npm",
    "dockerfile"
  ],
  "flux": {
    "managerFilePatterns": ["/^(apps|clusters|infrastructure)\\/.*\\.ya?ml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/^(apps|clusters|infrastructure)\\/.*\\.ya?ml$/"]
  },
  "packageRules": [
    {
      "description": "Review Talos and Kubernetes compatibility and upgrade steps manually",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["siderolabs/talos", "kubernetes/kubernetes"],
      "automerge": false
    },
    {
      "description": "Review Keycloak operator and server upgrades together",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["keycloak/keycloak-k8s-resources"],
      "automerge": false
    },
    {
      "description": "Review Cilium bootstrap and Flux adoption upgrades together",
      "matchPackageNames": ["quay.io/cilium/charts/cilium"],
      "groupName": "cilium chart",
      "automerge": false
    },
    {
      "description": "Review Flux Operator bootstrap and adoption upgrades together",
      "matchPackageNames": ["ghcr.io/controlplaneio-fluxcd/charts/flux-operator"],
      "groupName": "flux operator chart",
      "automerge": false
    },
    {
      "description": "Keep Flux OCI sources tag-based unless explicitly enabled for image values",
      "matchManagers": ["flux"],
      "pinDigests": false
    },
    {
      "description": "Pin container images in manifests, Dockerfiles and CI",
      "matchManagers": ["kubernetes", "dockerfile", "github-actions", "gitlabci"],
      "matchDatasources": ["docker"],
      "pinDigests": true
    },
    {
      "description": "Pin images in Flux HelmRelease values and Kustomizations",
      "matchManagers": ["flux"],
      "matchFileNames": ["**/*.helmrelease.yaml", "**/*.ks.yaml"],
      "matchDatasources": ["docker"],
      "pinDigests": true
    },
    {
      "description": "Leave non-image Kustomize dependencies unmanaged",
      "matchManagers": ["kustomize"],
      "enabled": false
    },
    {
      "description": "Pin Kustomize image overrides without pinning OCI Helm charts",
      "matchManagers": ["kustomize"],
      "matchDepTypes": ["Kustomization", "Component"],
      "matchDatasources": ["docker"],
      "enabled": true,
      "pinDigests": true
    },
    {
      "description": "Keep Flux OCI Helm chart versions as tags",
      "matchManagers": ["flux"],
      "matchDepTypes": ["HelmChart"],
      "pinDigests": false
    },
    {
      "description": "Upgrade Linkerd CRDs and control plane together",
      "matchManagers": ["flux"],
      "matchFileNames": ["infrastructure/components/linkerd/*.helmrelease.yaml"],
      "groupName": "linkerd charts",
      "automerge": false
    },
    {
      "description": "Update forum images together using plain X.Y.Z release image tags",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "ghcr.io/andreibe24/homelab-infrastructure/webapp-django-vite-backend",
        "ghcr.io/andreibe24/homelab-infrastructure/webapp-django-vite-frontend",
        "ghcr.io/andreibe24/homelab-infrastructure/webapp-django-vite-rag"
      ],
      "groupName": "forum app images",
      "allowedVersions": "/^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$/"
    },
    {
      "description": "Group forum backend dependencies, its base image and the CI Python version",
      "matchFileNames": [
        "src/webapp-django-vite/backend/**",
        "src/webapp-django-vite/Dockerfile.backend"
      ],
      "groupName": "forum backend dependencies"
    },
    {
      "description": "Group forum RAG dependencies and its base image",
      "matchFileNames": [
        "src/webapp-django-vite/rag/**",
        "src/webapp-django-vite/Dockerfile.rag"
      ],
      "groupName": "forum RAG dependencies"
    },
    {
      "description": "CI Python must move with the backend base image",
      "matchFileNames": [".github/workflows/lint-src.yaml"],
      "matchDepNames": ["python"],
      "groupName": "forum backend dependencies"
    },
    {
      "description": "Group forum frontend dependencies, its base images and the CI Node.js version",
      "matchFileNames": [
        "src/webapp-django-vite/frontend/**",
        "src/webapp-django-vite/Dockerfile.frontend"
      ],
      "groupName": "forum frontend dependencies"
    },
    {
      "description": "CI Node.js must move with the frontend build image",
      "matchFileNames": [".github/workflows/lint-src.yaml"],
      "matchDepNames": ["node"],
      "groupName": "forum frontend dependencies"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the pinned Keycloak operator bundle",
      "managerFilePatterns": ["/^clusters\\/dev\\/identity\\/operator\\/kustomization\\.yaml$/"],
      "matchStrings": [
        "https://github\\.com/keycloak/keycloak-k8s-resources//kubernetes\\?ref=(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "keycloak/keycloak-k8s-resources"
    },
    {
      "customType": "regex",
      "description": "Update the Dragonfly operator's remote manifest tag",
      "managerFilePatterns": ["/^infrastructure\\/components\\/redis-operator\\/kustomization\\.yaml$/"],
      "matchStrings": [
        "https://raw\\.githubusercontent\\.com/dragonflydb/dragonfly-operator/(?<currentValue>[^/\\s]+)/manifests/dragonfly-operator\\.yaml"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "dragonflydb/dragonfly-operator"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^(apps|clusters|infrastructure)\\/.*\\.sh$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\s+[A-Z0-9_]+_VERSION=\"(?<currentValue>[^\"]+)\""
      ]
    }
  ],
  "mise": {
    "managerFilePatterns": ["/^docs\\/config\\.toml$/"]
  }
}
